{
  "name": "@rekurt/openkline-react",
  "version": "0.1.0",
  "description": "React 18+/19 wrapper for @rekurt/openkline-core \u2014 <OHLCVChart> component and useOHLCVChart hook.",
  "keywords": [
    "ohlcv",
    "candlestick",
    "chart",
    "react",
    "trading",
    "canvas"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rekurt/openkline-react.git"
  },
  "bugs": {
    "url": "https://github.com/rekurt/openkline-react/issues"
  },
  "homepage": "https://github.com/rekurt/openkline-react#readme",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "workspaces": [
    "example"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src example/src --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p example/tsconfig.json",
    "dev:example": "npm run dev -w example",
    "build:example": "npm run build -w example",
    "update:core": "node scripts/update-core.mjs",
    "prepack": "npm run build"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "peerDependencies": {
    "@rekurt/openkline-core": "^0.2.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@rekurt/openkline-core": "file:./vendor/rekurt-openkline-core.tgz",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsup": "^8.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
